# ─── Model access ────────────────────────────────────────────────────────────
# AvalAI — OpenAI-compatible gateway to Gemini. Base URL includes /v1.
AI_BASE_URL="https://api.avalai.ir/v1"
AI_API_KEY="aa-..."

# YaraBot fallback. Leave empty until phase 6 wires it.
AI_FALLBACK_BASE_URL=""
AI_FALLBACK_API_KEY=""

# Model roles. Confirm these ids against AvalAI's live model list — `bun run probe`
# writes it to scripts/.models.json — rather than against Google's docs.
MODEL_REASONING="gemini-2.5-flash"
MODEL_FAST="gemini-2.5-flash-lite"
MODEL_EMBEDDING="text-embedding-004"
# Must match what probe 4 actually returns, and the vector() dimension in schema.prisma.
# Context window of MODEL_REASONING, for the usage ring in the chat header.
CONTEXT_LIMIT_TOKENS=250000

EMBEDDING_DIM="768"

# Phase 6 voice. Confirm the gateway actually serves it — `bun run probe:tts` generates
# Persian and transcribes it back. AvalAI proxies neither id below: it carries
# "gemini-2.5-flash-tts" and no xAI speech model at all.
MODEL_SPEECH="x-ai/grok-voice-tts-1.0"
SPEECH_VOICE="ara"           # or eve, leo, rex, sal
SPEECH_FORMAT="mp3"
# Gemini instead — reads Persian just as well, but on this gateway it times out on scripts
# over roughly 700 characters, and ours run to about 1500. Wired and one switch away:
# MODEL_SPEECH="google/gemini-3.1-flash-tts-preview"
# SPEECH_VOICE="Charon"      # or Aoede, Achernar
# SPEECH_FORMAT="pcm"        # its only container; narrate() adds the WAV header

# Uploaded photos and generated audio. Defaults to ./.uploads, which is fine on a
# workstation; on a server set an absolute path OUTSIDE the checkout so a redeploy cannot
# delete it. Deliberately not public/ — reads go through an authenticated route.
UPLOAD_DIR=".uploads"

# ─── Database ────────────────────────────────────────────────────────────────
# The application connection, and the only database URL lib/env.ts validates. This role
# owns one database and nothing more: it cannot create extensions, create roles, or read
# another database. Running the app as a superuser is how a SQL injection turns into a
# full compromise, so the two URLs stay separate.
DATABASE_URL="postgresql://ostad_app:CHANGE_ME@localhost:5432/ostad?schema=public"

# Signs the session cookie. Any 32+ character secret; `openssl rand -base64 32` works.
# Changing it logs every user out.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN"

# `prisma migrate dev` diffs against a shadow database. Its URL is derived from the one
# above by appending `_shadow` to the database name, and `db:bootstrap` creates it owned
# by the app role — otherwise migrate would need CREATEDB on that role.

# Setup only, never read by the app. `bun run db:bootstrap` uses this once to create the
# role above, its database, and the vector extension. Comment it out afterwards.
DATABASE_SUPERUSER_URL="postgresql://postgres:SUPERUSER_PASSWORD@localhost:5432/postgres"
